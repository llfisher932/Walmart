@{
    ViewData["Title"] = "About Us";
}

<div class="row ms-1 mt-4">

    <div class="p-4 mb-4 text-white rounded-3" style="background: linear-gradient(135deg, #0071ce, #004f9a);">
        <h1 class="fw-bold">About Walmart Groceries</h1>
        <p class="mb-0 fs-5">Saving people money so they can live better, since 1962.</p>
    </div>

    <div class="col-12 mb-4">
        <h3 class="fw-bold border-bottom pb-2">Who We Are</h3>
        <p>
            Walmart Groceries is a <strong>B2C (Business-to-Consumer)</strong> e-commerce platform that allows
            everyday customers to browse, select, and purchase fresh grocery products online. Our platform
            operates on a <strong>retail business model</strong>, purchasing products from suppliers and selling
            them directly to consumers at competitive prices.
        </p>
        <p>
            Our <strong>business process model</strong> follows a straightforward flow: customers browse our
            online catalog, add items to their cart, proceed through checkout, and receive order confirmation
            all while our backend securely processes and stores each transaction.
        </p>
    </div>

    <div class="col-12 mb-4">
        <h3 class="fw-bold border-bottom pb-2">Our Mission</h3>
        <p>
            Our mission is simple: <em>"Save Money. Live Better."</em> We are committed to offering the
            freshest grocery products at the lowest possible prices, making quality food accessible to
            every household. We strive to deliver a seamless, trustworthy, and convenient online
            shopping experience for all our customers.
        </p>
    </div>

    
    <div class="col-12 mb-4">
        <h3 class="fw-bold border-bottom pb-2">Executive Board</h3>
        <div class="row row-cols-1 row-cols-md-3 g-3">

            <div class="col">
                <div class="card border-0 shadow-sm h-100 text-center p-3">
                    <i class="fa fa-user-circle fa-3x text-primary mb-2"></i>
                    <h6 class="fw-bold mb-0">Doug McMillon</h6>
                    <small class="text-muted">President & CEO</small>
                </div>
            </div>

            <div class="col">
                <div class="card border-0 shadow-sm h-100 text-center p-3">
                    <i class="fa fa-user-circle fa-3x text-primary mb-2"></i>
                    <h6 class="fw-bold mb-0">John David Rainey</h6>
                    <small class="text-muted">Chief Financial Officer</small>
                </div>
            </div>

            <div class="col">
                <div class="card border-0 shadow-sm h-100 text-center p-3">
                    <i class="fa fa-user-circle fa-3x text-primary mb-2"></i>
                    <h6 class="fw-bold mb-0">Suresh Kumar</h6>
                    <small class="text-muted">Chief Technology Officer</small>
                </div>
            </div>

            <div class="col">
                <div class="card border-0 shadow-sm h-100 text-center p-3">
                    <i class="fa fa-user-circle fa-3x text-primary mb-2"></i>
                    <h6 class="fw-bold mb-0">Donna Morris</h6>
                    <small class="text-muted">Chief People Officer</small>
                </div>
            </div>

            <div class="col">
                <div class="card border-0 shadow-sm h-100 text-center p-3">
                    <i class="fa fa-user-circle fa-3x text-primary mb-2"></i>
                    <h6 class="fw-bold mb-0">Tom Ward</h6>
                    <small class="text-muted">Chief E-Commerce Officer</small>
                </div>
            </div>

            <div class="col">
                <div class="card border-0 shadow-sm h-100 text-center p-3">
                    <i class="fa fa-user-circle fa-3x text-primary mb-2"></i>
                    <h6 class="fw-bold mb-0">Kathryn McLay</h6>
                    <small class="text-muted">Chief Operations Officer</small>
                </div>
            </div>

        </div>
    </div>

</div>
