@model Product
<div class="col">
    <div class="card rounded-1 h-100">
        <div class="card-block m-2 h-100">
            <div class="card-body h-100 d-flex flex-column">
                <h3 class="card-title">
                    <strong>@Model.Name</strong>
                </h3>

                <p class="card-text lead">
                    @Model.Description
                </p>
                <div class="row mt-auto">
                    <div class="col my-auto">
                        
                    <div class="bg-success text-white text-center rounded h-100 p-2">
                        @Model.Price.ToString("c")
                    </div>
                    </div>
                    <div class="col">
                    <form id="@Model.ProductID" asp-action="AddToCart"
                          asp-controller="Cart" method="post" class=" w-100 h-100">
                        <input type="hidden" asp-for="ProductID" />
                        <input type="hidden" name="returnUrl"
                               value="@ViewContext.HttpContext.Request.PathAndQuery()" />
                        <button type="submit" class="btn btn-info btn-sm w-100 h-100">
                            Add To Cart
                        </button>
                    </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
