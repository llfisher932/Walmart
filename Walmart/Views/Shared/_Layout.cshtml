<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link rel="stylesheet" asp-href-include="lib/bootstrap/dist/css/*.min.css" />
    <link rel="stylesheet" asp-href-include="lib/font-awesome/css/*.css" />
    <title>Walmart</title>
</head>
<body class="d-flex min-vh-100 flex-column">
    <nav class="navbar navbar-inverse bg-primary justify-content-between w-100 px-2">
        <a class="navbar-brand ps-2" asp-controller="Home" asp-action="Index">
            <img src="//i5.walmartimages.com/dfw/63fd9f59-14e2/9d304ce6-96de-4331-b8ec-c5191226d378/v1/spark-icon.svg" class="h-auto img-fluid" style="width:50px;" />
        </a>
        <form class="d-flex flex-grow-1 mx-3" asp-controller="Product" asp-action="List" method="get">
            <input class="form-control me-2" type="search" name="searchQuery" placeholder="Search Walmart" aria-label="Search" />
            <button class="btn btn-warning fw-bold" type="submit">Search</button>
        </form>
        <div class="d-flex align-items-center gap-3 pe-3">
            <a asp-controller="Info" asp-action="About" class="text-white text-decoration-none small">About</a>
            <a asp-controller="Info" asp-action="Policies" class="text-white text-decoration-none small">Policies</a>
            <a asp-controller="Info" asp-action="Faq" class="text-white text-decoration-none small">FAQ</a>
            @await Component.InvokeAsync("CartSummary")
        </div>
    </nav>
    <div class="container">
        <div class="d-flex flex-nowrap overflow-auto">
            @await Component.InvokeAsync("NavigationMenu")
        </div>
        <div>
            @RenderBody()
        </div>
    </div>
    <footer class="mt-auto py-4 px-5 bg-primary text-white">
        <div class="d-flex justify-content-between flex-wrap gap-4">
            <div>
                <img src="//i5.walmartimages.com/dfw/63fd9f59-14e2/9d304ce6-96de-4331-b8ec-c5191226d378/v1/spark-icon.svg" style="width:35px;" class="mb-2" />
                <p class="small mb-0">© 2026 Walmart Groceries. All rights reserved.</p>
                <p class="small mb-0">Save Money. Live Better.</p>
            </div>
            <div>
                <h6 class="fw-bold">Shop</h6>
                <a asp-controller="Product" asp-action="List" class="d-block text-white text-decoration-none small">Groceries</a>
                <a asp-controller="Cart" asp-action="Index" asp-route-returnUrl="/" class="d-block text-white text-decoration-none small">My Cart</a>
                <a asp-controller="Order" asp-action="Checkout" class="d-block text-white text-decoration-none small">Checkout</a>
            </div>
            <div>
                <h6 class="fw-bold">Company</h6>
                <a asp-controller="Home" asp-action="Index" class="d-block text-white text-decoration-none small">Home</a>
                <a asp-controller="Info" asp-action="About" class="d-block text-white text-decoration-none small">About Us</a>
                <a asp-controller="Info" asp-action="Faq" class="d-block text-white text-decoration-none small">FAQ</a>
            </div>
            <div>
                <h6 class="fw-bold">Policies</h6>
                <a asp-controller="Info" asp-action="Policies" class="d-block text-white text-decoration-none small">Shipping Policy</a>
                <a asp-controller="Info" asp-action="Policies" class="d-block text-white text-decoration-none small">Return Policy</a>
                <a asp-controller="Info" asp-action="Policies" class="d-block text-white text-decoration-none small">Tax Policy</a>
            </div>
        </div>
    </footer>
</body>
</html>