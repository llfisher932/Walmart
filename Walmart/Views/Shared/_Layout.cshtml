<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link rel="stylesheet" asp-href-include="lib/bootstrap/dist/css/*.min.css" />
    <link rel="stylesheet" asp-href-include="lib/font-awesome/css/*.css" />
    <title>Walmart</title>
</head>
<body>
    <nav class="navbar navbar-inverse bg-primary justify-content-between w-100 px-2">
        <a class="navbar-brand ps-2" asp-controller="Home" asp-action="Index">
            <img src="//i5.walmartimages.com/dfw/63fd9f59-14e2/9d304ce6-96de-4331-b8ec-c5191226d378/v1/spark-icon.svg" class="h-auto img-fluid" style="width:50px;" />
        </a>
        <form class="d-flex flex-grow-1 mx-3" asp-controller="Product" asp-action="List" method="get">
            <input class="form-control me-2" type="search" name="searchQuery" placeholder="Search Walmart" aria-label="Search" />
            <button class="btn btn-warning fw-bold" type="submit">Search</button>
        </form>
        <div class="d-flex align-items-center gap-3 pe-3">
            <a asp-controller="Info" asp-action="About" class="text-white text-decoration-none small">About</a>
            <a asp-controller="Info" asp-action="Policies" class="text-white text-decoration-none small">Policies</a>
            <a asp-controller="Info" asp-action="FAQ" class="text-white text-decoration-none small">FAQ</a>
            <a asp-controller="Order" asp-action="Retrieve" class="text-white text-decoration-none small">My Orders</a>
            @await Component.InvokeAsync("CartSummary")
        </div>
    </nav>
    <div class="container">
            <div class="d-flex overflow-x-scroll">
                @await Component.InvokeAsync("NavigationMenu")
            </div>
            <div>
                @RenderBody()
            </div>
    </div>
</body>
</html>
