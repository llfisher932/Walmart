<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link rel="stylesheet" asp-href-include="lib/bootstrap/dist/css/*.min.css" />
    <link rel="stylesheet" asp-href-include="lib/font-awesome/css/*.css" />
    <title>Walmart</title>
</head>
<body>
    <nav class="navbar navbar-inverse bg-primary">
        <nav class="navbar navbar-inverse bg-primary justify-content-between w-100">
            <a class="navbar-brand ps-2" href="/"><img src="//i5.walmartimages.com/dfw/63fd9f59-14e2/9d304ce6-96de-4331-b8ec-c5191226d378/v1/spark-icon.svg" class="h-auto mw-10 img-fluid" style="width: 50px;" /></a>
            <form class="d-flex flex-grow-1 mx-3" asp-controller="Product" asp-action="List" method="get">
                <input class="form-control me-2" type="search" name="searchQuery" placeholder="Search Walmart" aria-label="Search" />
                <button class="btn btn-warning fw-bold" type="submit">Search</button>
            </form>
            <div class="float-start pe-4 text-white">
                @await Component.InvokeAsync("CartSummary")
            </div>
        </nav>
    </nav>
    <div class="container">
            <div class="d-flex overflow-x-scroll">
                @await Component.InvokeAsync("NavigationMenu")
            </div>
            <div>
                @RenderBody()
            </div>
    </div>
    <div class="position-absolute bottom-0 py-3 px-5 bg-primary w-100 justify-content-between align-content-center d-flex text-white">
        
        <div></div>
        <div>test link 1</div>
        <div>test link 2</div>
        <div>test link 3</div>
        <div>test link 4</div>
        <div>test link 5</div>
        <div>test link 6</div>
        <div>test link 7</div>
        <div></div>

    </div>
</body>
</html>
