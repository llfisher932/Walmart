@model IEnumerable<string>

    <a class="btn btn-outline-dark btn-block m-2 col"
       asp-action="Index"
       asp-controller="Home">
        Home
    </a>

@foreach (string category in Model)
{
        <a class="btn btn-outline-dark btn-block m-2 col @(category == ViewBag.SelectedCategory ? "btn-primary": "btn-outline-dark")"
           asp-action="List"
           asp-controller="Product"
           asp-route-category="@category"
           asp-route-page="1">
            @category
        </a>
}
