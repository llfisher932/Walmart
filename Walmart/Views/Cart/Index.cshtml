@model CartIndexViewModel

<div class="row ms-1">
    <h2>Your cart</h2>
    @if (TempData["EmptyCartError"] != null)
    {
        <div class="alert alert-warning">@TempData["EmptyCartError"]</div>
    }

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th class="text-center">Quantity</th>
                <th>Item</th>
                <th class="text-right">Price</th>
                <th class="text-right">Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in Model.Cart.Lines)
            {
                <tr>
                    <td class="text-center">
                        <form asp-action="UpdateQuantity" method="post" class="d-flex align-items-center justify-content-center">
                            <input type="hidden" name="productId" value="@line.Product.ProductID" />
                            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                            <input type="number" name="quantity" value="@line.Quantity" min="1"
                                   class="form-control form-control-sm text-center" style="width:70px"
                                   onchange="this.form.submit()" />
                        </form>
                    </td>
                    <td class="text-left">@line.Product.Name</td>
                    <td class="text-right">@line.Product.Price.ToString("c")</td>
                    <td class="text-right">
                        @((line.Quantity * line.Product.Price).ToString("c"))
                    </td>
                    <td>
                        <form asp-action="RemoveFromCart" method="post">
                            <input type="hidden" name="ProductID"
                                   value="@line.Product.ProductID" />
                            <input type="hidden" name="returnUrl"
                                   value="@Model.ReturnUrl" />
                            <button type="submit" class="btn btn-sm btn-danger ">
                                Remove
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            @{
                var subtotal = Model.Cart.ComputeTotalValue();
                var shipping = subtotal >= 35 ? 0m : 5.99m;
                var tax = subtotal * 0.075m;
                var total = subtotal + shipping + tax;
            }
            <tr>
                <td colspan="3" class="text-right">Subtotal:</td>
                <td class="text-right">@subtotal.ToString("c")</td>
            </tr>
            <tr>
                <td colspan="3" class="text-right">Shipping:</td>
                <td class="text-right">@(shipping == 0 ? "FREE" : shipping.ToString("c"))</td>
            </tr>
            <tr>
                <td colspan="3" class="text-right">Tax (7.5%):</td>
                <td class="text-right">@tax.ToString("c")</td>
            </tr>
            <tr class="fw-bold">
                <td colspan="3" class="text-right">Total:</td>
                <td class="text-right">@total.ToString("c")</td>
            </tr>
        </tfoot>
    </table>
</div>

<div class="text-center">
    <a class="btn btn-primary" href="@Model.ReturnUrl">Continue shopping</a>
    @if (Model.Cart.Lines.Any())
    {
        <a class="btn btn-success" asp-action="Checkout" asp-controller="Order">Checkout</a>
    }

</div>
